{
  "version": 2,
  "outputDirectory": "app/web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api(?:\\/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
