# =============================================================================
# GITFLOW / GITPULSE - ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client URL (For CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Database Connection (Neon Serverless PostgreSQL connection string with SSL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
NEON_DB_URL=postgresql://neondb_owner:npg_sample_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# GitHub OAuth App Credentials
# Create at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# JWT Secret for Session Token Signing
JWT_SECRET=gitflow_super_secret_jwt_key_2026_secure_random_hash

# GitHub Webhook Secret (Optional, for payload HMAC verification)
GITHUB_WEBHOOK_SECRET=gitflow_webhook_secret_key_2026
