{
  "name": "gitflow-monorepo",
  "version": "1.0.0",
  "description": "GitFlow - Plataforma de Gestión Ágil y Telemetría de Código en Tiempo Real",
  "private": true,
  "workspaces": [
    "backend",
    "app/web"
  ],
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix app/web",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix app/web",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --prefix app/web",
    "build": "npm run build:frontend",
    "vercel-build": "npm run build:frontend",
    "test": "npm run test --prefix backend",
    "test:coverage": "npm run test:coverage --prefix backend",
    "start": "npm start --prefix backend"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
